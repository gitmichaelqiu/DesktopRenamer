<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE dictionary SYSTEM "file://localhost/System/Library/DTDs/sdef.dtd">
<dictionary title="DesktopRenamer Terminology">
    <suite name="DesktopRenamer Suite" code="DskR" description="Commands for DesktopRenamer">

        <record-type name="api information" code="DskI" description="Structured API capabilities and version information">
            <property name="contract version" code="Cvrs" type="text"><cocoa key="contractVersion"/></property>
            <property name="JSON-RPC version" code="JRpc" type="text"><cocoa key="jsonRPCVersion"/></property>
            <property name="supported methods" code="SMet" type="list of text"><cocoa key="supportedMethods"/></property>
            <property name="legacy notifications" code="LNot" type="boolean"><cocoa key="legacyNotifications"/></property>
            <property name="event notifications" code="ENot" type="boolean"><cocoa key="eventNotifications"/></property>
            <property name="maximum payload bytes" code="MPBy" type="integer"><cocoa key="maxPayloadBytes"/></property>
        </record-type>

        <record-type name="space" code="DkSp" description="A managed Mission Control space">
            <property name="id" code="SpID" type="text"><cocoa key="id"/></property>
            <property name="name" code="SpNm" type="text"><cocoa key="name"/></property>
            <property name="display ID" code="DsID" type="text"><cocoa key="displayID"/></property>
            <property name="display name" code="DsNm" type="text"><cocoa key="displayName"/></property>
            <property name="number" code="SpNo" type="integer"><cocoa key="number"/></property>
            <property name="full screen" code="Fscr" type="boolean"><cocoa key="isFullscreen"/></property>
            <property name="app name" code="ApNm" type="text"><cocoa key="appName"/></property>
            <property name="app path" code="ApPt" type="text"><cocoa key="appPath"/></property>
            <property name="global shortcut number" code="GsNo" type="integer"><cocoa key="globalShortcutNumber"/></property>
        </record-type>

        <record-type name="space snapshot" code="DkSn" description="A versioned snapshot of Mission Control spaces">
            <property name="API version" code="ApiV" type="text"><cocoa key="apiVersion"/></property>
            <property name="revision" code="RvNo" type="integer"><cocoa key="revision"/></property>
            <property name="timestamp" code="TmSt" type="text"><cocoa key="timestamp"/></property>
            <property name="current space IDs" code="CsID" type="list of text"><cocoa key="currentSpaceIDs"/></property>
            <property name="current space name" code="CsNm" type="text"><cocoa key="currentSpaceName"/></property>
            <property name="spaces" code="Spcs" type="list of space"><cocoa key="spaces"/></property>
        </record-type>

        <record-type name="window" code="DkWi" description="An application window assigned to a space">
            <property name="id" code="WiID" type="integer"><cocoa key="id"/></property>
            <property name="process ID" code="PrID" type="integer"><cocoa key="pid"/></property>
            <property name="owner name" code="OwNm" type="text"><cocoa key="ownerName"/></property>
            <property name="app path" code="WiPt" type="text"><cocoa key="appPath"/></property>
            <property name="title" code="WiTl" type="text"><cocoa key="title"/></property>
            <property name="space ID" code="WiSp" type="text"><cocoa key="spaceID"/></property>
            <property name="minimized" code="MiWd" type="boolean"><cocoa key="isMinimized"/></property>
            <property name="hidden" code="HiWd" type="boolean"><cocoa key="isHidden"/></property>
        </record-type>

        <record-type name="window snapshot" code="DkWs" description="A versioned snapshot of spaces and application windows">
            <property name="API version" code="WApi" type="text"><cocoa key="apiVersion"/></property>
            <property name="revision" code="WRNo" type="integer"><cocoa key="revision"/></property>
            <property name="timestamp" code="WTmS" type="text"><cocoa key="timestamp"/></property>
            <property name="spaces" code="WSpc" type="list of space"><cocoa key="spaces"/></property>
            <property name="windows" code="WWns" type="list of window"><cocoa key="windows"/></property>
        </record-type>

        <command name="get api information" code="DskRGInf" description="Get structured API version and capability information">
            <cocoa class="DesktopRenamer.GetAPIInformationCommand"/>
            <result type="api information" description="API contract and capability information"/>
        </command>

        <command name="get structured spaces" code="DskRGSps" description="Get all spaces as typed records">
            <cocoa class="DesktopRenamer.GetStructuredSpacesCommand"/>
            <result type="list of space" description="Spaces sorted by display and space number"/>
        </command>

        <command name="get structured snapshot" code="DskRGSnp" description="Get a versioned typed snapshot of all spaces">
            <cocoa class="DesktopRenamer.GetStructuredSnapshotCommand"/>
            <result type="space snapshot" description="Versioned space snapshot"/>
        </command>

        <command name="get structured windows" code="DskRGWsn" description="Get spaces and windows as typed records">
            <cocoa class="DesktopRenamer.GetStructuredWindowsCommand"/>
            <result type="window snapshot" description="Versioned space and window snapshot"/>
        </command>
        
        <command name="toggle menubar" code="DskRTMen" description="Toggle the visibility of the menubar item">
            <cocoa class="DesktopRenamer.ToggleMenubarCommand"/>
            <result type="boolean" description="The new visibility state (true = visible)"/>
        </command>
        
        <command name="toggle launcher" code="DskRTlau" description="Toggle the launcher window visibility">
            <cocoa class="DesktopRenamer.ToggleLauncherCommand"/>
            <result type="boolean" description="The new visibility state (true = visible)"/>
        </command>
        
        <command name="toggle labels" code="DskRTLab" description="Toggle both Active &amp; Preview Label Windows">
            <cocoa class="DesktopRenamer.ToggleLabelsCommand"/>
            <result type="boolean" description="The new enabled state (true = enabled)"/>
        </command>

        <command name="toggle active label" code="DskRTAct" description="Toggle the Active Label Window">
            <cocoa class="DesktopRenamer.ToggleActiveLabelCommand"/>
            <result type="boolean" description="The new visibility state (true = visible)"/>
        </command>

        <command name="toggle preview label" code="DskRTPrv" description="Toggle the Preview Label Window">
            <cocoa class="DesktopRenamer.TogglePreviewLabelCommand"/>
            <result type="boolean" description="The new visibility state (true = visible)"/>
        </command>
        
        <command name="toggle desktop visibility" code="DskRTVis" description="Toggle visibility of Active Label Window on Desktop (Keep on Desktop)">
            <cocoa class="DesktopRenamer.ToggleDesktopVisibilityCommand"/>
            <result type="boolean" description="The new visibility state (true = visible on desktop)"/>
        </command>

        <command name="rename current space" code="DskRRCur" description="Rename the current space to the given string">
            <cocoa class="DesktopRenamer.RenameCurrentSpaceCommand"/>
            <direct-parameter description="The new name" type="text"/>
        </command>
        
        <command name="get current space name" code="DskRGCur" description="Get the name of the current space">
            <cocoa class="DesktopRenamer.GetCurrentSpaceNameCommand"/>
            <result type="text" description="The name of the current space"/>
        </command>

        <command name="get api version" code="DskRAPIV" description="Get the version of the external API contract">
            <cocoa class="DesktopRenamer.GetAPIVersionCommand"/>
            <result type="text" description="The semantic version of the external API contract"/>
        </command>
        
        <command name="get all spaces" code="DskRGAll" description="Get a list of all spaces in format 'ID~Name~DisplayID~Num'">
            <cocoa class="DesktopRenamer.GetAllSpacesCommand"/>
            <result type="text" description="List of spaces separated by newlines, format: ID~Name~DisplayID~Num"/>
        </command>
        
        <command name="rename space" code="DskRRnSp" description="Rename a specific space by ID">
            <cocoa class="DesktopRenamer.RenameSpaceCommand"/>
            <direct-parameter description="The ID of the space" type="text"/>
            <parameter name="to" code="ToNm" description="The new name" type="text" optional="no">
                <cocoa key="newName"/>
            </parameter>
        </command>
        
        <command name="switch to space" code="DskRSwSp" description="Switch to a space by ID">
            <cocoa class="DesktopRenamer.SwitchToSpaceCommand"/>
            <direct-parameter description="The ID of the space to switch to" type="text"/>
        </command>

        <command name="rearrange space" code="DskRRrSp" description="Move a space one position up or down">
            <cocoa class="DesktopRenamer.RearrangeSpaceCommand"/>
            <direct-parameter description="The ID of the space to move" type="text"/>
            <parameter name="direction" code="Drct" description="The direction to move the space" type="text" optional="no">
                <cocoa key="direction"/>
            </parameter>
        </command>

        <command name="move window next" code="DskRMvNx" description="Move the active window to the next desktop">
            <cocoa class="DesktopRenamer.MoveWindowNextCommand"/>
        </command>

        <command name="move window previous" code="DskRMvPr" description="Move the active window to the previous desktop">
            <cocoa class="DesktopRenamer.MoveWindowPreviousCommand"/>
        </command>

        <command name="move window to space" code="DskRMvTo" description="Move the active window to a specific space by ID">
            <cocoa class="DesktopRenamer.MoveWindowToSpaceCommand"/>
            <direct-parameter description="The ID of the space to move the window to" type="text"/>
        </command>

        <command name="reload space labels" code="DskRRelL" description="Reload all space label windows to fix glitches">
            <cocoa class="DesktopRenamer.ReloadSpaceLabelsCommand"/>
            <result type="boolean" description="True if successful, false if API is disabled"/>
        </command>

        <command name="get windows" code="DskRGWin" description="Get all visible app windows grouped by space">
            <cocoa class="DesktopRenamer.GetWindowsCommand"/>
            <result type="text" description="Windows grouped by space, format: >SpaceHeader lines followed by indented window entries"/>
        </command>

        <command name="focus window" code="DskRFocW" description="Bring a specific window to the front">
            <cocoa class="DesktopRenamer.FocusWindowCommand"/>
            <direct-parameter description="The window ID (CGWindowID)" type="text"/>
            <parameter name="pid" code="WPid" description="The owner process ID" type="text" optional="no">
                <cocoa key="ownerPID"/>
            </parameter>
        </command>

        <command name="execute window action" code="DskREwAc" description="Execute a control action on a window (e.g. close, minimize, hide, enterFullScreen, exitFullScreen, quit, restore)">
            <cocoa class="DesktopRenamer.ExecuteWindowActionCommand"/>
            <direct-parameter description="The window ID (CGWindowID)" type="text"/>
            <parameter name="pid" code="WPid" description="The owner process ID" type="text" optional="no">
                <cocoa key="ownerPID"/>
            </parameter>
            <parameter name="action" code="WAct" description="The action to perform (close, minimize, hide, enterFullScreen, exitFullScreen, quit, restore)" type="text" optional="no">
                <cocoa key="actionName"/>
            </parameter>
        </command>

        <command name="move specific window" code="DskRMvSW" description="Move a specific window to a target space">
            <cocoa class="DesktopRenamer.MoveSpecificWindowToSpaceCommand"/>
            <direct-parameter description="The window ID (CGWindowID)" type="text"/>
            <parameter name="pid" code="WPid" description="The owner process ID" type="text" optional="yes">
                <cocoa key="ownerPID"/>
            </parameter>
            <parameter name="from space" code="FmSp" description="The source space ID (ManagedSpaceID)" type="text" optional="no">
                <cocoa key="fromSpace"/>
            </parameter>
            <parameter name="to space" code="MvSp" description="The target space ID (ManagedSpaceID)" type="text" optional="no">
                <cocoa key="targetSpace"/>
            </parameter>
        </command>

        <command name="get current space id" code="DskRGCID" description="Get the ManagedSpaceID(s) of the currently visible space(s)">
            <cocoa class="DesktopRenamer.GetCurrentSpaceIDCommand"/>
            <result type="text" description="Comma-separated ManagedSpaceIDs of currently visible spaces"/>
        </command>

    </suite>
</dictionary>
